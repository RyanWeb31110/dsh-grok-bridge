# Copy to a file you source before launching dsh. Do not commit the copy.
# Do not put these in ~/.dsh/.env — some dsh versions treat unknown DSH_* keys there as fatal.

# Shared inbound bearer. openssl rand -hex 32
DSH_GROK_TOKEN=

# 127.0.0.1 behind `tailscale serve`, a 100.x address, or 0.0.0.0 only with an ACL.
DSH_GROK_BIND=127.0.0.1
DSH_GROK_PORT=8791

# Empty uses $DSH_HOME/dsh-grok-bridge/tasks.json (or ~/.dsh/...).
DSH_GROK_STORE=

# Default working directory for tasks that omit `cwd`. Empty = process cwd.
DSH_GROK_CWD=

# Optional comma-separated absolute prefixes. Empty = any directory the OS user can use.
DSH_GROK_CWD_ALLOWLIST=

# Optional model route. Set both, or neither to keep the profile default.
DSH_GROK_PROVIDER=
DSH_GROK_MODEL=

# Outbound events. Happy path: a URL on the Grok Bot tailnet node (100.x or *.ts.net).
# Cursor cloud routine URLs work, and they leave the tailnet.
DSH_GROK_OUTBOUND_WEBHOOK_URL=
DSH_GROK_OUTBOUND_TOKEN=
DSH_GROK_OUTBOUND_HMAC_SECRET=

# 0 disables. Non-zero values are raised to at least 60000 ms.
DSH_GROK_HEARTBEAT_MS=0

# Optional per-event overrides. Empty falls back to DSH_GROK_OUTBOUND_WEBHOOK_URL.
DSH_GROK_WEBHOOK_COMPLETED=
DSH_GROK_WEBHOOK_FAILED=
DSH_GROK_WEBHOOK_NEEDS_APPROVAL=
DSH_GROK_WEBHOOK_HEARTBEAT=

# Demo simulator only (scripts/demo.sh). Not read by the dsh plugin.
DSH_GROK_DEMO_DELAY_MS=200
